      "runtimeArgs": ["--prefix", "frontend", "run", "start"],
      "port": 4200
    },
    {
      "name": "frontend-pwa",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "frontend/dist/frontend/browser", "-p", "4300", "-c-1"],
