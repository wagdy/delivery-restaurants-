<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>20da1585-07a1-438c-a1ca-6806969e7c1f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="dotnet-passbook" Version="4.0.1" />
    <PackageReference Include="Google.Apis.Walletobjects.v1" Version="1.75.0.4235" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RestaurantDelivery.Core\RestaurantDelivery.Core.csproj" />
    <ProjectReference Include="..\RestaurantDelivery.Infrastructure\RestaurantDelivery.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Apple Wallet pass artwork (icon/logo/strip PNGs, at 1x/2x/3x) - not shipped yet;
         AppleWalletSettings.IsConfigured also checks these exist, so the wallet feature
         stays safely "unconfigured" until real branding is dropped in here. -->
    <Content Include="Assets\ApplePass\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
